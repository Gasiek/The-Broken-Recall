<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/common-styles.uss?fileID=7433441132597879392&amp;guid=f5a483d70588545eeabe7eb35fd0f894&amp;type=3#common-styles"/>
    
    <ui:VisualElement name="Backdrop" class="remove-action-backdrop" style="display: none;">
        <ui:VisualElement name="Panel" class="fullscreen-action-panel">
            
            <!-- Title pinned to top -->
            <ui:Label text="Choose an action to Remove" class="action-panel-title"/>
            
            <!-- Centered Scrollable Area -->
            <ui:ScrollView name="ScrollView" mode="Vertical" class="remove-action-scroll">
                <ui:VisualElement name="CardContainer" class="remove-action-grid"/>
            </ui:ScrollView>

            <!-- Cancel Button pinned to bottom -->
            <ui:Button name="CancelButton" text="Cancel" class="dialog-button button action-panel-cancel-button"/>
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>