<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/common-styles.uss?fileID=7433441132597879392&amp;guid=f5a483d70588545eeabe7eb35fd0f894&amp;type=3#common-styles"/>
    
    <ui:VisualElement name="Backdrop" class="remove-action-backdrop" style="display: none;">
        <ui:VisualElement name="Panel" class="remove-action-panel">
            
            <ui:Label text="Choose an action to Remove" class="remove-action-title"/>
            
            <!-- Vertical Scroll View -->
            <ui:ScrollView name="ScrollView" mode="Vertical" class="remove-action-scroll">
                <!-- Grid container with spacing gaps -->
                <ui:VisualElement name="CardContainer" class="remove-action-grid"/>
            </ui:ScrollView>

            <ui:Button name="CancelButton" text="Cancel" class="dialog-button button" style="margin-top: 10px; margin-bottom: 20px;"/>
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>